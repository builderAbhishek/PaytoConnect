# SMART QR - Apache URL Rewriting for Clean URLs
# Supports:
#   /pay/chaudhary -> /pay.php?slug=chaudhary
#   /admin         -> /admin/login.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /pay/some-slug to pay.php?slug=some-slug
    RewriteRule ^pay/([a-zA-Z0-9_-]+)/?$ pay.php?slug=$1 [L,QSA]

    # Clean access to admin directory
    RewriteRule ^admin/?$ admin/dashboard.php [L,QSA]
</IfModule>

# Prevent directory browsing
Options -Indexes
